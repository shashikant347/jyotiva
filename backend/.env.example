# Copy to .env and edit. In production JWT_SECRET and OTP_SECRET are REQUIRED (32+ random chars).
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
JWT_SECRET=
OTP_SECRET=
# Trusted proxy hop count (integer 0-10; 0 = none). Set to the exact number of proxies in front of the API.
TRUST_PROXY=0
# Dev only: the send-otp response includes the code so you can log in without an SMS provider.
EXPOSE_DEV_OTP=true
# MongoDB Atlas: paste your connection string. Required in production; only development can use local JSON.
MONGODB_URI=
MONGODB_DB=jyotiva
# Optional for shared online presence across API instances; leave blank for local development.
REDIS_URL=
# Optional browser push; generate a persistent VAPID key pair and keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
DATA_FILE=data/db.json
ADMIN_PHONES=
# Optional business settings; commission is 0-100, free chat duration is 1-3600 seconds, payout is integer paise.
PLATFORM_COMMISSION_PERCENT=30
FREE_CHAT_SECONDS=300
FREE_CHAT_PAYOUT_PAISE=0
# Dev: demo astrologers are seeded on first start. Set to false to skip, or true to force in production (not recommended).
SEED_DEMO=true
# Also seed linked preview records for every data model (users, wallets, chats, support, etc.).
# Development only; all these records are fictional and visibly marked DEMO.
SEED_ALL_DEMO=false
# Payments. Leave empty in development to use the mock gateway. Production requires real Razorpay keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
