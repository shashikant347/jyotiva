# Copy to .env and edit. In production JWT_SECRET and OTP_SECRET are REQUIRED (32+ random chars).
PORT=4000
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=
OTP_SECRET=
# Number of reverse proxies in front of the API (0 = none). Needed for correct client IPs in rate limiting.
TRUST_PROXY=0
# Dev only: the send-otp response includes the code so you can log in without an SMS provider.
EXPOSE_DEV_OTP=true
DATA_FILE=data/db.json
